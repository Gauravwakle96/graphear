{
  "name": "graphear",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "dev:web": "vite --config apps/web/vite.config.ts",
    "dev:api": "tsx watch apps/api/src/index.ts",
    "build": "npm run typecheck && node scripts/build.mjs",
    "start": "node dist/server.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "eslint apps packages scripts tests --max-warnings 0",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "prepare:ocr": "node scripts/prepare-ocr.mjs",
    "benchmark": "tsx scripts/benchmark.ts",
    "check": "npm run lint && npm run test:coverage && npm run build",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "examples": "tsx scripts/examples.ts",
    "test:smoke": "node scripts/smoke.mjs"
  },
  "dependencies": {
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "1.64.1",
    "@types/dompurify": "^3.0.5",
    "@types/express": "5.0.6",
    "@types/multer": "^2.3.0",
    "@types/node": "^24.10.0",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@vitejs/plugin-react": "6.1.2",
    "@vitest/coverage-v8": "5.0.5",
    "esbuild": "^0.28.0",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "7.1.1",
    "prettier": "^3.9.10",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "typescript-eslint": "8.72.1",
    "vite": "8.3.5",
    "vitest": "5.0.5"
  },
  "engines": {
    "node": ">=24.0.0"
  },
  "overrides": {
    "minimatch": "11.0.1"
  }
}
