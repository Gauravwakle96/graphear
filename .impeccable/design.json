      "description": "Native diagram-title field with a persistent label.",
      "html": "<label class=\"ds-field\">Diagram title<input class=\"ds-input\" type=\"text\" value=\"Scholarship application\" /></label>",
      "css": ".ds-field{display:grid;gap:7px;margin:16px 0;color:var(--text,#203b32);font-family:Manrope,sans-serif;font-size:0.875rem;font-weight:500}.ds-input{width:100%;min-height:44px;padding:10px 12px;border:1px solid var(--line,#d9e1d5);border-radius:7px;background:var(--surface,#fff);color:var(--text,#203b32);font-family:Manrope,sans-serif;font-size:1rem;font-weight:400;caret-color:var(--accent,#256344)}.ds-input::placeholder{color:var(--muted,#52665a);opacity:1}.ds-input:focus-visible{outline:3px solid var(--focus,#1c68b8);outline-offset:4px}"
    },
    {
      "name": "Main Navigation",
      "kind": "nav",
      "refersTo": "navigation",
      "description": "Forest rail with an explicit current-page state; horizontal on mobile.",
      "html": "<nav class=\"ds-nav\" aria-label=\"Main navigation\"><a class=\"ds-nav-link ds-nav-active\" href=\"#workspace\" aria-current=\"page\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"22\" height=\"22\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M15 6a9 9 0 0 0-9 9V3\"></path><circle cx=\"18\" cy=\"6\" r=\"3\"></circle><circle cx=\"6\" cy=\"18\" r=\"3\"></circle></svg><span>Workspace</span></a><a class=\"ds-nav-link\" href=\"#library\">Library</a></nav>",
      "css": ".ds-nav{display:flex;flex-direction:column;gap:12px;width:100px;padding:26px 9px;background:var(--nav,#193b2e);font-family:Manrope,sans-serif}.ds-nav-link{display:flex;flex-direction:column;align-items:center;justify-content:center;gap:8px;min-height:74px;padding:9px 0;color:#cadbce;text-decoration:none;font-size:0.75rem;border-radius:9px}.ds-nav-link:hover{background:#254e3a}.ds-nav-active{color:#fff;background:#315f45}.ds-nav-link:focus-visible{outline:3px solid #a6d5ff;outline-offset:4px}@media(max-width:600px){.ds-nav{flex-direction:row;gap:6px;width:auto;padding:8px 12px}.ds-nav-link{flex:1;min-height:56px;padding:5px;gap:4px;font-size:0.6875rem}.ds-nav-link svg{width:19px;height:19px}}"
    },
    {
      "name": "Confirmed Status Badge",
      "kind": "chip",
      "refersTo": "badge-success",
      "description": "Informational confirmation state with text and SVG.",
      "html": "<span class=\"ds-badge\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"14\" height=\"14\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><circle cx=\"12\" cy=\"12\" r=\"10\"></circle><path d=\"m16 9-5.5 5.5L8 12\"></path></svg><span>Confirmed structure</span></span>",
      "css": ".ds-badge{display:inline-flex;align-items:center;gap:6px;padding:5px 8px;border-radius:5px;background:var(--sage,#edf3e8);color:var(--accent,#256344);font-family:Manrope,sans-serif;font-size:0.75rem;line-height:1.5}"
    },
    {
      "name": "Working Panel",
      "kind": "card",
      "refersTo": "panel",
      "description": "Flat exploration/review container with an inset selected step.",
      "html": "<aside class=\"ds-panel\" aria-label=\"Accessible diagram explorer\"><h2>Explore the path</h2><p class=\"ds-panel-intro\">Choose a branch to move through the diagram.</p><div class=\"ds-step\"><h3 tabindex=\"-1\">Start application</h3><p>Current step</p></div></aside>",
      "css": ".ds-panel{padding:22px;background:var(--surface,#fff);color:var(--text,#203b32);border:1px solid var(--line,#d9e1d5);border-radius:10px;font-family:Manrope,sans-serif}.ds-panel h2{margin:0;font-size:1rem;line-height:1.45;letter-spacing:-0.015em;font-weight:700}.ds-panel-intro{margin:8px 0 20px;font-size:0.8125rem;line-height:1.65;color:var(--muted,#52665a)}.ds-step{padding:17px;background:var(--subtle,#eef2eb);border-radius:7px;margin:20px 0 14px}.ds-step h3{margin:0;font-size:1.0625rem;line-height:1.5;font-weight:700}.ds-step p{margin:12px 0 0;font-size:0.75rem;line-height:1.65;color:var(--muted,#52665a)}.ds-step h3:focus{outline:3px solid var(--focus,#1c68b8);outline-offset:4px;border-radius:2px}@media(max-width:1190px){.ds-panel{padding:18px}}@media(max-width:600px){.ds-panel{padding:20px}}"
    },
    {
      "name": "Graph Process Node",
      "kind": "custom",
      "refersTo": "graph-node",
      "description": "Native process node with semantic selected state.",
      "html": "<button class=\"ds-node\" aria-pressed=\"false\" aria-label=\"Verify documents, process\"><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"15\" height=\"15\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><rect width=\"18\" height=\"18\" x=\"3\" y=\"3\" rx=\"2\"></rect></svg><span>Verify documents</span></button>",
      "css": ".ds-node{display:flex;align-items:center;justify-content:center;gap:7px;width:220px;min-height:76px;padding:7px 8px;border:1px solid #a0b598;border-radius:8px;background:var(--sage,#edf3e8);color:var(--text,#203b32);font-family:Manrope,sans-serif;font-size:0.8125rem;font-weight:600;line-height:1.4;text-align:center;overflow-wrap:anywhere;cursor:pointer;transition:background-color 180ms ease-out,border-color 180ms ease-out}.ds-node:hover{border-color:var(--accent,#256344);filter:brightness(0.98)}.ds-node[aria-pressed=\"true\"]{background:var(--selection,#e7f1ff);border:2px solid var(--focus,#1c68b8)}.ds-node:focus-visible{outline:3px solid var(--focus,#1c68b8);outline-offset:4px}@media(prefers-reduced-motion:reduce){.ds-node{transition:none}}"
    },
    {
      "name": "Branch Button",
      "kind": "custom",
      "refersTo": "branch-button",
      "description": "Full branch label and target text used for keyboard traversal.",
      "html": "<button class=\"ds-branch\"><span class=\"ds-branch-copy\"><strong>Yes</strong><span>Income under ₹2.5 lakh?</span></span><svg xmlns=\"http://www.w3.org/2000/svg\" width=\"18\" height=\"18\" viewBox=\"0 0 24 24\" fill=\"none\" stroke=\"currentColor\" stroke-width=\"2\" stroke-linecap=\"round\" stroke-linejoin=\"round\" aria-hidden=\"true\"><path d=\"M5 12h14\"></path><path d=\"m12 5 7 7-7 7\"></path></svg></button>",
      "css": ".ds-branch{display:flex;align-items:center;justify-content:space-between;gap:12px;min-height:70px;width:100%;padding:14px;border:1px solid var(--line,#d9e1d5);border-radius:7px;background:var(--surface,#fff);color:var(--text,#203b32);font-family:Manrope,sans-serif;text-align:left;cursor:pointer}.ds-branch-copy{display:grid;gap:5px}.ds-branch strong{font-size:0.8125rem;font-weight:700;color:var(--accent,#256344)}.ds-branch-copy>span{font-size:0.8125rem}.ds-branch:hover{background:var(--subtle,#eef2eb);border-color:var(--accent,#256344)}.ds-branch:focus-visible{outline:3px solid var(--focus,#1c68b8);outline-offset:4px}"
    }
  ],
  "narrative": {
    "northStar": "A Readable Route",
    "overview": "Graphear uses a quiet forest shell around a readable working ground. Sage process nodes, amber decisions, green outcomes and blue current selection make graph state visible without competing with the diagram. Manrope, fine separators and native controls keep the interface consistent across exploration, editing, source review and learning.\n\nThe visual language supports keyboard and structured text interaction alongside the canvas. Color reinforces labels, node types, review status and path structure; it does not replace those descriptions. Flat working surfaces keep attention on the graph, while restrained shadows identify temporary menus, confirmations and dialogs.\n\nThis record is derived from the finished code and the user-pinned green-and-neutral direction. There is no approved visual comp or quality card. The independent reviewer inspected six viewport/theme captures and five workflow captures and returned a ship verdict on four scored fixes: keyboard traversal focus, fixed-size branch labels, original-source enlargement and metadata below the selected-step heading. That verdict is limited to those fixes. No blind or low-vision user study, screen-reader usability session or measured learning improvement is established.",
    "keyCharacteristics": [
      "Forest navigation and green-neutral working surfaces in light and dark themes.",
      "Compact Manrope hierarchy with fixed-size graph labels.",
      "Native controls, visible focus and text equivalents for graph actions.",
      "Semantic node fills, path highlighting and explicit source-review states."
    ],
    "rules": [
      {
        "name": "The State Has a Name Rule",
        "body": "Pair node and review colors with a type, label, status or structured description. Blue selection and traversal never carry meaning alone.",
        "section": "colors"
      },
      {
        "name": "The Theme Pair Rule",
        "body": "Use the matching light or dark semantic tokens. Keep original-source pixels and their viewing ground faithful to the imported document.",
        "section": "colors"
      },
      {
        "name": "The Fixed Label Rule",
        "body": "Keep rendered branch labels at the graph-label role outside the scaled SVG. Preserve the full branch label in the explorer and structured text.",
        "section": "typography"
      },
      {
        "name": "The Working Plane Rule",
        "body": "Working panels remain flat. Reserve the observed soft shadows for floating menus, transient confirmations and modal dialogs.",
        "section": "elevation"
      }
    ],
    "dos": [
      "Do use the semantic light/dark pairs for surfaces, text, borders, node fills and selection.",
      "Do keep primary actions, navigation, fields and branches as native, labelled controls with visible focus.",
      "Do place the selected-step heading before its type and review metadata and move focus to that heading after branch traversal.",
      "Do preserve source-review uncertainty with explicit text and dashed graph connections or nodes.",
      "Do retain reduced-motion behavior and the canvas scroll region at narrow widths."
    ],
    "donts": [
      "Don't substitute a decorative hero or fabricated results for the working diagram and its text interaction.",
      "Don't scale branch typography inside the graph SVG or truncate the explorer's full branch descriptions.",
      "Don't use color as the only indication of selection, outcome, review status or change.",
      "Don't treat the scoped ship verdict or automated accessibility checks as evidence of user validation."
    ]
  }
}
