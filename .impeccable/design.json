      "css": ".ds-btn-ghost{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 14px;border:1px solid var(--line,#d9e1d5);border-radius:7px;background:var(--surface,#fff);color:var(--text,#203b32);font-family:Manrope,sans-serif;font-size:0.8125rem;font-weight:600;line-height:1.3;cursor:pointer;transition:background-color 160ms ease-out,border-color 160ms ease-out}.ds-btn-ghost:hover{background:var(--subtle,#eef2eb);border-color:var(--muted,#52665a)}.ds-btn-ghost:focus-visible{outline:3px solid var(--focus,#1c68b8);outline-offset:4px}.ds-btn-ghost:disabled{opacity:0.48;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn-ghost{transition:none}}.ds-btn-ghost{background:transparent;border-color:transparent}.ds-btn-ghost:hover{background:var(--subtle,#eef2eb);border-color:var(--muted,#52665a)}"
