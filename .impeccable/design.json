  "components": [
    {
      "name": "Primary Button",
      "kind": "button",
      "refersTo": "button-primary",
      "description": "Primary save or confirmation action.",
      "html": "<button class=\"ds-btn-primary\">Save diagram</button>",
      "css": ".ds-btn-primary{display:inline-flex;align-items:center;justify-content:center;gap:8px;min-height:44px;padding:10px 14px;border:1px solid var(--line,#d9e1d5);border-radius:7px;background:var(--surface,#fff);color:var(--text,#203b32);font-family:Manrope,sans-serif;font-size:0.8125rem;font-weight:600;line-height:1.3;cursor:pointer;transition:background-color 160ms ease-out,border-color 160ms ease-out}.ds-btn-primary:hover{background:var(--subtle,#eef2eb);border-color:var(--muted,#52665a)}.ds-btn-primary:focus-visible{outline:3px solid var(--focus,#1c68b8);outline-offset:4px}.ds-btn-primary:disabled{opacity:0.48;cursor:not-allowed}@media(prefers-reduced-motion:reduce){.ds-btn-primary{transition:none}}.ds-btn-primary{background:var(--accent,#256344);border-color:var(--accent,#256344);color:#fff}.ds-btn-primary:hover{background:var(--accent-hover,#184a32);border-color:var(--muted,#52665a)}:host-context([data-theme=\"dark\"]) .ds-btn-primary{color:#183126}"
