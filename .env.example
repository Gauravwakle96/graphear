PORT=3001
HOST=127.0.0.1
DATABASE_PATH=data/graphear.sqlite
# Comma-separated frontend origins allowed to create sessions and change projects.
ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3001,http://127.0.0.1:3001
# Production behind HTTPS: NODE_ENV=production; set ALLOWED_ORIGINS to the real URL.
# Public origin supplied by the operator. Render's RENDER_EXTERNAL_URL is also supported.
APP_PUBLIC_URL=
# Leave 0 for direct traffic. Use 1 only with one verified proxy and no direct public access.
PROXY_TRUST_HOPS=0
# Legacy local diagram mode needs no AI key. Learning AI mode uploads privately.
# Copy to .env on the server; never put keys in VITE_* variables or commit .env.
AI_PROVIDER=openai
# Set 1 only for an account verified to use free quota; controls pricing copy.
AI_FREE_TIER=0
OPENAI_API_KEY=
OPENAI_MODEL=gpt-6-astra
OPENAI_TRANSCRIPTION_MODEL=gpt-transcribe
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash
# Optional for models supporting thinkingBudget; 0 disables thinking for lower latency.
# Leave blank for the provider default. Some models require thinking and reject 0.
GEMINI_THINKING_BUDGET=
AI_TIMEOUT_SECONDS=120
AI_DAILY_CALL_LIMIT=50
AI_JOB_CALL_LIMIT=12
LEARNING_UPLOAD_MB=100
LEARNING_MEDIA_MINUTES=30
LEARNING_RETENTION_HOURS=168
LEARNING_UPLOAD_DIR=data/learning
FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
# Optional official YouTube API metadata/captions. OAuth must have caption rights.
YOUTUBE_API_KEY=
YOUTUBE_OAUTH_TOKEN=
